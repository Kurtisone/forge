# Copy this file to .env.local and adjust:
#   cp .env.example .env.local
#
# Every variable here has a working default in forge/config.py --
# you only need to uncomment/change what you want to override.
# Full explanations: README.md > Configuration.

# --- Provider selection --------------------------------------------------
# One of: llama_cpp | ollama | openrouter
# FORGE_PROVIDER=llama_cpp
# LLM_MODEL=default

# --- llama.cpp (default provider) -----------------------------------------
# Running under podman/Containerfile? 127.0.0.1 means the container
# itself, not your host. Point this at the host instead:
#   http://host.containers.internal:8080   (podman)
#   http://host.docker.internal:8080       (Docker Desktop)
# LLAMA_CPP_URL=http://127.0.0.1:8080
# LLAMA_CPP_TIMEOUT=120
# LLAMA_CPP_N_PREDICT=512
# Grammar-constrained decoding: forces the model's output to match the
# router's exact JSON schema at the sampling level. Disable if your
# server version rejects the "grammar" field.
# LLAMA_CPP_USE_GRAMMAR=true
# Prompt cache (v3.8): Forge only ever drives one conversation, so a
# fixed slot is always safe here -- pinning it lets llama-server reuse
# the KV cache from the previous turn's matching prefix instead of
# recomputing it every call.
# LLAMA_CPP_ID_SLOT=0
# LLAMA_CPP_CACHE_PROMPT=true

# --- Ollama -----------------------------------------------------------------
# Same container-networking note as LLAMA_CPP_URL above applies here.
# OLLAMA_URL=http://127.0.0.1:11434/api/generate

# --- OpenRouter ---------------------------------------------------------
# Required if FORGE_PROVIDER=openrouter. Get a key at openrouter.ai/keys.
# OPENROUTER_API_KEY=
# OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions

# --- Runtime safety -----------------------------------------------------
# Ceiling on router->tool steps per run. Multi-step only actually
# happens if the router response includes "done": false.
# The memory tool's recall path relies on this: it sets "done": false
# so a second step can phrase the raw search results as a natural
# reply. With MAX_STEPS=1 (default), that second step never runs and
# recall answers stay as a raw bullet list -- bump this to at least 2
# if you want memory's recall answers to read naturally.
# MAX_STEPS=1

# Raising MAX_STEPS above 1 is what opens the indirect prompt-injection
# surface of audit E-2: from the second step on, the previous step's
# tool output is part of the prompt choosing the next tool call, so the
# text of a fetched web page or a system log gets a say in it. The
# orchestrator answers that deterministically -- once a run has called
# web_fetch/web_search/research/sysadmin, no later step of that run may
# dispatch shell, test, or files:write. Set this to true only if you
# have a real flow that needs to write after fetching AND you trust
# every source it reads. A blocked step is not a dead end: the same
# request asked as a fresh turn starts with a clean slate.
# ALLOW_MUTATION_AFTER_EXTERNAL_DATA=false

# --- Tools ----------------------------------------------------------------
# Only tools listed here are dispatchable, regardless of what a
# module implements. chat,code is the conservative default; add
# files/shell/git once you trust the sandboxing for your setup,
# memory once you have an embedding server running (see below), and
# review/test/web_fetch/web_search/research as each of their own
# sections below is configured.
#
# One combination is worth knowing about before you write it (audit
# E-1): `files` + `test` is equivalent to `shell`, whatever
# SHELL_ALLOWED_COMMANDS says. Running pytest means executing the
# Python code in the workspace -- that is what a test runner is -- so
# writing a file and then running it is arbitrary code execution
# through two tools that each look narrow on their own. A warning is
# logged at startup when both are enabled. See SECURITY.md.
# ENABLED_TOOLS=chat,code,files,shell,git,memory,recall,review,test,web_fetch,web_search,research
# WORKSPACE_DIR=data/workspace
# SHELL_TIMEOUT=30
# Only parts[0] is checked, never the arguments -- so adding an
# interpreter (python3, pip, find, xargs, sh, git, sed, awk...) makes
# this list decorative: `python3 -c "..."` runs anything. That's a
# reasonable thing to do on a trusted local box, and a bad thing to do
# on anything reachable over WireGuard. A warning is logged at startup
# when one of them is present.
# SHELL_ALLOWED_COMMANDS=ls,cat,head,tail,wc,grep

# --- Test/lint tool ---------------------------------------------------------
# Separate allowlist from the general shell tool above, on purpose --
# see tools/test.py.
# TEST_TIMEOUT=60
# TEST_ALLOWED_COMMANDS=pytest,ruff

# --- Review graph (search a file, optionally run its tests, then review) --
# No config of its own beyond ENABLED_TOOLS -- reuses WORKSPACE_DIR
# confinement (tools/review.py) and the test tool above when a
# test_path is given. Dispatchable from chat: "relis X et donne ton
# avis", or "relis X et lance ses tests dans Y".

# --- Web fetch --------------------------------------------------------------
# Fetches a URL you already know -- see tools/web_fetch.py for the
# SSRF guard (not configurable) and its known limitation on heavy,
# non-semantic sites.
# WEB_FETCH_TIMEOUT=15
# WEB_FETCH_MAX_BYTES=2097152
# Empty = any public domain is fetchable, subject to the SSRF guard.
# WEB_FETCH_ALLOWED_DOMAINS=

# --- Web search (SearXNG) ----------------------------------------------------
# Requires a self-hosted SearXNG instance -- not a cloud search API.
# SearXNG's own settings.yml needs "json" added to search.formats
# (disabled by default upstream to discourage scraping public
# instances; fine to enable on a private, self-hosted one).
# Running under podman/Docker? Same host.containers.internal /
# host.docker.internal note as LLAMA_CPP_URL above applies here.
# Only returns a ranked links/snippets list, no synthesis -- for an
# actual answer, use "research" below instead.
# SEARXNG_URL=http://127.0.0.1:8888
# SEARXNG_TIMEOUT=10
# SEARXNG_MAX_RESULTS=5

# --- Research graph (search -> fetch top N -> synthesize) ------------------
# The default choice for an actual answer/summary about something
# current ("actualités", "quoi de neuf sur X") -- a single
# dispatchable call that runs search, fetches the top results, and
# synthesizes one answer internally (see graphs/research.py). Exists
# specifically because chaining "web_search" into a router-decided
# second step proved unreliable with small local models. Requires the
# same SearXNG instance as web_search above (doesn't need
# "web_search" itself in ENABLED_TOOLS, calls it directly).
# RESEARCH_FETCH_TOP_N=3
# RESEARCH_FETCH_CHARS_PER_RESULT=1500

# --- Recall graph (memory search -> synthesize) -----------------------------
# The default choice for a natural-language question about something
# recorded in memory ("tu te souviens", "rappelle-moi") -- a single
# dispatchable call that searches memory and synthesizes one answer
# internally (see graphs/recall.py). Exists for the same reason as
# research above: chaining memory:recall into a router-decided second
# step (the old "done": false pattern) proved unreliable with small
# local models. Requires the same embedding server as memory below
# (doesn't need "memory" itself in ENABLED_TOOLS, calls it directly).
# RECALL_MAX_ANSWER_CHARS=800

# Distance above which a retrieved memory entry is not shown to the
# synthesis step. UNSET = no filtering, and that is still the default.
#
# MEASURED on the Deck, 2026-08-21, with bench/recall_distance.py:
#
#     hits    0.6943 0.7439 0.9226 0.9351 0.9402  (all rank 1)
#     misses  1.1096 1.1708 1.2071 1.2197 1.2586
#
# That suggested 1.05 -- and a first --no-plant run against a COPY of
# the real store said otherwise the same day:
#
#     hit   "Tu peux me lister mon matériel"         0.8934
#     miss  "la date d'anniversaire de mon cousin ?" 0.9891
#
# The real store's MISS sits at 0.9891, BELOW the fixture-derived 1.05.
# A cutoff taken from the fixtures would let it straight through. Long
# compaction summaries sit at middling distance from every question
# ever asked, so they compress the whole scale: hits and misses both
# move closer together.
#
# So the fixtures validate the mechanism, not the number. Measured
# again on 2026-08-22, six questions against a copy of the real store,
# before and after it was re-sliced one entry per exchange:
#
#     before   hits 0.8934 0.671 0.9386 | misses 0.9891 0.9356 1.098
#              worst hit 0.9386 > best miss 0.9356  ->  NO GAP
#     after    hits 0.4498 0.671 0.7695 | misses 1.0619 0.8337 1.0369
#              worst hit 0.7695 < best miss 0.8337  ->  gap 0.0642
#
# The intake change is what made a threshold choosable at all. The
# short fact (0.671) did not move -- only the entries that had been
# buried in a compacted block did, which is the control.
#
# 0.95, not the midpoint the harness suggests. Two of the three misses
# are "nothing here is relevant" (1.0619, 1.0369) and that is what this
# setting is for; the third sits at 0.8337 only because the store
# contains a lexically similar sentence that does not answer the
# question, and no number separates that cleanly. Too high lets a bad
# answer through, which gets argued with; too low answers "je n'ai rien
# en mémoire" while holding the answer, which gets believed.
#
# recall.dropped logs every cut with its id and distance, so a value
# that bites in the wrong place shows up in the logs.
#
# Re-measure against a COPY of your own store before trusting it:
#     recall_distance.py --db /tmp/real_copy.db --no-plant \
#         --hit "..." --miss "..."
#
# The one ACTIVE line in this file, deliberately. Everything else here
# is a commented default that also lives in config.py; this value does
# not, because it was measured against one specific store rather than
# derived from anything general. Unset (the config default) still means
# no filtering at all, so a deployment that has not measured its own
# store is not silently given someone else's number.
#
# The @tag is the embedding configuration the number was measured
# against (rag.query_fingerprint()), and a5c47b is the one this file
# ships. Measured 2026-08-24 on a real store of ~300 entries, six
# questions whose answers were known: worst hit 0.7289, best miss
# 0.9495, and 0.88 sits inside that gap with room above the hits
# because real entries are longer and messier than any fixture.
#
# READ THIS BEFORE INHERITING THE NUMBER. It was measured on one
# person's store, and the tag will NOT warn you about that -- keep the
# default instruction and your fingerprint matches theirs, so the
# cutoff engages silently on a number that has never seen your data. A
# store of a different size, language or subject puts its hits
# somewhere else. The tag catches a change of embedding configuration,
# which is a different question from whether the measurement was ever
# yours. Comment this line out and you get no filtering at all, which
# is the safe starting point; run bench/in_container.sh recall_distance
# against a copy of your own store to earn a number of your own.
RECALL_MAX_DISTANCE=0.88@a5c47b

# Asking again, in other words, when the cutoff above has dropped
# everything -- instead of answering "je n'ai rien d'assez proche".
#
#   off     never. The default.
#   terms   deterministic rewrites: the frame and the stopwords
#           removed. MEASURED WORSE on this store, 2026-08-24, on four
#           questions out of four -- this embedding model is
#           instruction-tuned on natural-language queries and a
#           keyword bag is off-distribution for it. Kept so the
#           finding stays reproducible. Do not turn it on.
#   llm     ONE model call asking for three queries written with the
#           words the ANSWER would use. This is the half that works:
#           it moved #308 from absent-from-the-top-5 to rank 2 on the
#           question that motivated the whole thing.
#
# It runs on that path ONLY, so a question that already works costs
# exactly what it cost before, and no distance the threshold was
# calibrated against moves: the tag above stays valid and nothing has
# to be re-measured before you can try this.
#
# INERT WITHOUT A CUTOFF. With RECALL_MAX_DISTANCE commented out
# nothing is ever dropped, so there is never a failure to rescue.
# Forge warns at startup rather than leaving you to wonder.
#
# The price is a rephrasing that lands nearer some unrelated entry
# than the question did, turning a correct refusal into a fluent wrong
# answer. Count both sides on a copy of your own store first:
#   bench/in_container.sh recall_expansion --db /tmp/real_copy.db \
#       --hit "une question dont tu SAIS que la réponse est dedans" --expect <id> \
#       --miss "une question dont tu sais qu'elle n'y est pas"
# MEASURED ON THIS STORE, 2026-08-24, AND LEFT OFF. The rescue moves
# the right entries closer and the wrong ones away, and still cannot
# separate them: with five or six overlapping short facts every
# distance bunches between 0.94 and 1.14. Three readings of the gap,
# negative every time. Fill the store first; the harness and the
# numbers are in docs/memory.md, and the question reopens in one
# command.
#RECALL_EXPANSION=off

# Searching the WORDS as well as the vectors (v3.17).
#
# What it is for: an entry no phrasing reaches. #307 and #313 are in
# the store on this box and six rounds of query expansion never
# brought either one back -- #313 is written "Steam Deck, SteamOS,
# conteneurs Podman", a keyword list, which is the shape an
# instruction-tuned embedding model retrieves worst. No threshold
# fixes that: the entry never comes back to be filtered. Its words
# are right there.
#
# RECALL_MAX_DISTANCE ABOVE IS NEVER APPLIED TO A WORD MATCH, and
# that is the design rather than an oversight. 0.88@a5c47b was
# measured on vector distances, in one embedding regime, and says
# nothing about a row admitted because the question and the entry
# share a rare word. Applying it would delete exactly what this
# channel exists to reach, since those entries are FAR in vector
# space. Turning this on does not invalidate that number and does not
# ask you to measure it again.
#
# It cannot displace a good answer either: word matches are ordered
# after measured distances and carry their own budget, so a question
# that already works returns what it returned before with rows
# appended.
#
# THE COST IS THE ONE THE EXPANSION PASS WAS TURNED OFF FOR: a row
# that shares a rare word with the question without answering it, and
# this store is full of the family -- the archived refusals
# (#35/#36/#37) QUOTE the question they failed to answer, which makes
# them excellent word matches for it. Count both sides on a copy of
# your own store first:
#   bench/in_container.sh rag_hybrid --db /tmp/real_copy.db \
#       --hit "une question dont tu SAIS que la réponse est dedans" --expect <id> \
#       --miss "une question dont tu sais qu'elle n'y est pas"
#RECALL_LEXICAL=false
# How many word matches reach synthesis. A recall prompt is paid for
# twice, in context window and in prefill time.
#RECALL_LEXICAL_TOP_K=3
# The admission rule of that channel, and deliberately not a score
# threshold -- a bm25 cutoff would be a second number needing its own
# calibration and its own @tag. A word is searched for when it
# appears in at most this share of the store: "matériel" and "Podman"
# name a handful of rows, "mon" and "que" name half of it. The
# dictionary is the store itself, so there is no stopword list to
# maintain and nothing that assumes French. rag.lexical logs the
# words kept and the words refused with their counts on every search,
# so both directions of this knob are visible rather than guessed at.
#RECALL_LEXICAL_MAX_DF=0.2

# --- Memory ---------------------------------------------------------------
# MEMORY_ENABLED=true
# MEMORY_FILE=data/memory.json
# MEMORY_MAX_HISTORY=100
# When the hard cap does fire, trim this many messages BELOW the cap.
# Landing exactly on the cap makes the next turn evict again, and every
# turn after that -- a sliding window that invalidates the prompt cache
# on every single turn. Set to 0 for the old behaviour.
# MEMORY_HARD_CAP_SLACK=20
# Higher than it looks necessary for conversation length -- a low
# value makes the sliding-window eviction fight KV-cache reuse (see
# config.py). RAG (below) is the long-term store; this is only the
# short-term window shown to the router.

# --- Vector memory / RAG (v3.7) --------------------------------------------
# Separate, embedding-only llama.cpp instance -- distinct from
# LLAMA_CPP_URL above, which stays dedicated to chat/tool-dispatch.
# EMBEDDING_DIM must match whatever model you actually serve.
# EMBEDDING_URL=http://127.0.0.1:8082/embedding
# EMBEDDING_DIM=1024
# EMBEDDING_TIMEOUT=30
# An embedding server needs the whole input in one physical batch, so
# llama-server rejects anything past --ubatch-size (default 512 tokens)
# with a 400 rather than truncating. Longer text is split into chunks of
# at most this many characters and the vectors averaged. Raise it only
# if you also raise -b/-ub on the embedding server.
# EMBEDDING_MAX_CHARS=1500
# EMBEDDING_MAX_CHUNKS=16
# Per-hit ceiling on what the memory tool feeds back into the router
# prompt. Facts are one line; a history_summary written by compaction is
# a whole archived conversation block, so a handful of hits can bury the
# one line that answered the question.
# MEMORY_RECALL_MAX_CHARS=500
# RAG_DB_FILE=data/forge_rag.db

# --- Execution trace ------------------------------------------------------
# TRACE_ENABLED=true
# TRACE_FILE=data/traces.jsonl

# --- Debug ------------------------------------------------------------------
# SHOW_DEBUG=false

# --- API auth ---------------------------------------------------------------
# Bearer token required on /chat, /review, /run, /tools, /traces,
# /remember, /search, /history, /drawer, /compact.
# Forge REFUSES TO START if this is empty, unless you also set
# API_ALLOW_UNAUTHENTICATED=true below. That's deliberate: /chat
# dispatches whatever is in ENABLED_TOOLS, so an open instance is
# arbitrary tool execution for anyone who can reach the port.
# API_TOKEN=
#
# Set to true only for a genuinely local-only instance you want open on
# purpose. Never set it on anything reachable over WireGuard/LAN.
# API_ALLOW_UNAUTHENTICATED=false
#
# Interactive docs: /docs, /redoc and /openapi.json. FastAPI mounts
# these itself, so API_TOKEN above cannot cover them -- they are either
# published to anyone who can reach the port, or not mounted at all.
# Not mounted by default; turn on while developing against the API.
# API_DOCS_ENABLED=false

# --- API rate limiting -------------------------------------------------------
# In-memory sliding window, per client IP, single-process only.
# Applies to the same routes as API_TOKEN above, plus /health -- which
# stays open (healthchecks have no token) but is metered, because each
# hit costs an outbound call to the inference server.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_REQUESTS=30
# RATE_LIMIT_WINDOW_SECONDS=60

# --- Policy Engine ----------------------------------------------------------
# Deny gate consulted before any capability runs. Each flag blocks a whole
# class of capability by the static requirements it declares, whatever the
# tool is called — see ARCHITECTURE.md, "Policy Engine", and `forge
# capabilities` to see the effect.
#
# It can only subtract from what ENABLED_TOOLS already allows: turning a flag
# on never makes a tool reachable that was not opted in.
#
# Typical use is a degraded context. Off the network that hosts SearXNG or the
# embedding server, POLICY_ALLOW_NETWORK=false makes research / web_fetch /
# web_search refuse with a stated reason instead of failing later with a
# connection error, while chat, code, memory and review keep working.
# POLICY_ALLOW_NETWORK=true
# POLICY_ALLOW_WORKSPACE_WRITES=true
# POLICY_ALLOW_SUBPROCESS=true

# Instruction prefixed to SEARCH queries only, never to what gets stored.
# Qwen3-Embedding is instruction-aware; measured +0.057 of hit/miss gap on
# the real store (docs/memory.md). Leave empty for a model that is not.
# Changing it invalidates the RECALL_MAX_DISTANCE you calibrated -- which
# is now enforced rather than advised: the cutoff turns itself off when
# its @tag no longer matches.
#EMBEDDING_QUERY_INSTRUCT=Given a question asked in conversation, retrieve the stored facts, decisions and past exchanges that answer it
